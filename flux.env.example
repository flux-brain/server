# Flux secrets. Copy to $FLUX_HOME/flux.env, chmod 600. Never commit the real file.
DISCORD_BOT_TOKEN=          # the bot made for Flux (Message Content intent on; see INSTALL.md)
DISCORD_GUILD_ID=           # your server id
ROUTINE_FIRE_TOKEN=         # API trigger token of the vault-inbox routine (claude.ai/code/routines)
GITHUB_TOKEN=               # fine-grained token: contents read/write on the vault repo only
OPS_WEBHOOK_URL=            # optional: Discord webhook for failure alerts

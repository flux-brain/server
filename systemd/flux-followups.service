[Unit]
Description=Flux follow-up module: one pass (sent emails waiting for an answer -> vault followups/waiting.md)
After=network-online.target

[Service]
Type=oneshot
User=flux
Group=flux
Environment=FLUX_HOME=/var/lib/flux
ExecStart=/usr/bin/flock -n /run/lock/flux-followups.lock /var/lib/flux/venv/bin/flux-followups
StandardOutput=append:/var/lib/flux/logs/followups.log
StandardError=inherit
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/flux /run/lock
PrivateTmp=true
NoNewPrivileges=true

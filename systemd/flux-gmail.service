[Unit]
Description=Flux Gmail module: one pass (labelled conversations -> vault captures)
After=network-online.target

[Service]
Type=oneshot
User=flux
Group=flux
Environment=FLUX_HOME=/var/lib/flux
ExecStart=/usr/bin/flock -n /run/lock/flux-gmail.lock /var/lib/flux/venv/bin/flux-gmail
StandardOutput=append:/var/lib/flux/logs/gmail.log
StandardError=inherit
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/flux /run/lock
PrivateTmp=true
NoNewPrivileges=true
